---
import GridCanvas from "./GridCanvas.astro";
---

<section class="hero">
  <GridCanvas />

  <div class="hero-copy">
    <p class="hero-eyebrow">SynUp Digital Solutions</p>
    <h1 class="hero-title">
      Your business,<br /><span class="grad">synced up digitally</span>
    </h1>
    <p class="hero-sub">
      We build the systems, websites, networks, and visuals that keep modern
      businesses connected from first click to daily operations.
    </p>
    <div class="hero-actions">
      <a href="/services" class="btn-primary">Explore Services</a>
      <a href="/contact" class="btn-ghost">Talk to Us</a>
    </div>
    <div class="hero-stats">
      <div>
        <div class="hero-stat-num">200+</div>
        <div class="hero-stat-label">Projects Delivered</div>
      </div>
      <div>
        <div class="hero-stat-num">98%</div>
        <div class="hero-stat-label">Client Satisfaction</div>
      </div>
      <div>
        <div class="hero-stat-num">5+</div>
        <div class="hero-stat-label">Years Experience</div>
      </div>
    </div>
  </div>

  <div class="hero-brand" aria-hidden="true">
    <div class="logo-orbit">
      <div class="brand-card">
        <img src="/synup-logo.jpeg" alt="" />
      </div>
      <div class="pixel-stack">
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
      </div>
    </div>
  </div>
</section>
