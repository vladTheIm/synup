---
import ServiceCard from "./ServiceCard.astro";

const services = [
  {
    title: "Systems Management",
    description: "We configure, monitor, and maintain servers, devices, software, and daily support so operations stay steady.",
    icon: `<svg viewBox="0 0 24 24"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/><path d="M9 10l2 2 4-4"/></svg>`,
  },
  {
    title: "Website Development",
    description: "Fast, responsive websites built around clear content, smooth UX, performance, and real business goals.",
    icon: `<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>`,
  },
  {
    title: "Networking",
    description: "Secure network infrastructure for offices, wireless systems, remote access, firewalls, and reliable connectivity.",
    icon: `<svg viewBox="0 0 24 24"><rect x="2" y="14" width="6" height="4" rx="1"/><rect x="9" y="8" width="6" height="10" rx="1"/><rect x="16" y="4" width="6" height="14" rx="1"/><path d="M5 14V9M12 8V5M19 4V2"/></svg>`,
  },
  {
    title: "Graphics Designing",
    description: "Brand identity, marketing assets, social visuals, and UI graphics that make the company look consistent everywhere.",
    icon: `<svg viewBox="0 0 24 24"><path d="M12 19l7-7 3 3-7 7-3-3z"/><path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"/><path d="M2 2l7.586 7.586"/><circle cx="11" cy="11" r="2"/></svg>`,
  },
];
---

<section id="services">
  <div class="services-header">
    <span class="section-tag">What we do</span>
    <h2 class="section-title">Four connected digital services</h2>
    <p class="section-sub">SynUp keeps the whole stack joined up: systems, websites, networking, and visual design under one dependable team.</p>
  </div>
  <div class="services-grid">
    {services.map((s) => <ServiceCard title={s.title} description={s.description} icon={s.icon} />)}
  </div>
</section>
