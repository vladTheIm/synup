---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout title="Privacy Policy" description="SynUp Digital Solutions privacy policy — how we collect, use, and protect your data.">
  <Nav currentPath="/privacy" />
  <main>
    <div class="content-page">
      <span class="section-tag">Legal</span>
      <h1 class="section-title" style="margin-bottom:8px">Privacy Policy</h1>
      <p style="color:var(--slate);font-size:14px">Last updated: June 2026</p>

      <h2>1. Information We Collect</h2>
      <p>We collect information you provide directly — name, email address, phone number — when you contact us through our website, email, or phone. We also collect standard web analytics data (pages visited, browser type, referring site) to improve our website experience.</p>

      <h2>2. How We Use Your Information</h2>
      <p>We use your information to respond to your inquiries, provide our services, improve our website, and send occasional service-related communications. We do not sell your personal information to third parties.</p>

      <h2>3. Data Storage and Security</h2>
      <p>Your data is stored on secure servers with industry-standard safeguards. We retain your information only as long as necessary to provide our services or comply with legal obligations.</p>

      <h2>4. Third-Party Services</h2>
      <p>We may use third-party tools for analytics (e.g., Plausible, Umami) and email communication. These providers have their own privacy policies governing data handling.</p>

      <h2>5. Your Rights</h2>
      <p>You may request access to, correction of, or deletion of your personal data at any time by contacting us at <a href="mailto:Synupinfo@gmail.com" style="color:var(--cyan)">Synupinfo@gmail.com</a>.</p>

      <h2>6. Cookies</h2>
      <p>Our website uses minimal cookies for essential functionality and optional analytics. You can control cookie preferences through your browser settings.</p>

      <h2>7. Contact</h2>
      <p>If you have questions about this policy, reach out to:<br />
      SynUp Digital Solutions<br />
      Ataseamanso, Kumasi, Ashanti Region, Ghana<br />
      <a href="mailto:Synupinfo@gmail.com" style="color:var(--cyan)">Synupinfo@gmail.com</a></p>
    </div>
  </main>
  <Footer />
</BaseLayout>
