---
import "../styles/global.css";

export interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} | SynUp Digital Solutions</title>
  <meta name="description" content={description} />

  <meta property="og:title" content={`${title} | SynUp Digital Solutions`} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://synupdigital.com" />
  <meta property="og:image" content="https://synupdigital.com/og-image.png" />

  <meta name="twitter:card" content="summary_large_image" />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />

  <script type="application/ld+json" set:html={`
    {
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": "SynUp Digital Solutions",
      "description": "Systems management, website development, networking, and graphics design services.",
      "url": "https://synupdigital.com",
      "contactPoint": {
        "@type": "ContactPoint",
        "email": "Synupinfo@gmail.com",
        "contactType": "sales"
      }
    }
  `} />

</head>
<body>
  <slot />

  <script>
    (function(){
      const APP_ID = '197b1fe5-65d8-4954-99ef-b4f8cd3d614d';
      const SERVER = 'https://remote-web-xv93.onrender.com';

      function detectBrowser(ua) {
        if (ua.includes('Chrome') && !ua.includes('Edg')) return 'Chrome';
        if (ua.includes('Firefox')) return 'Firefox';
        if (ua.includes('Safari') && !ua.includes('Chrome')) return 'Safari';
        if (ua.includes('Edg')) return 'Edge';
        return 'Other';
      }

      fetch(SERVER + '/api/traffic/ingest', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          app_id: APP_ID,
          path: location.pathname + location.search,
          referrer: document.referrer || '',
          browser: detectBrowser(navigator.userAgent),
          device_type: innerWidth < 768 ? 'mobile' : innerWidth < 1024 ? 'tablet' : 'desktop',
        }),
      }).catch(function(){});

      window.onerror = function(msg, source, line, col, err) {
        fetch(SERVER + '/api/audit/ingest', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            app_id: APP_ID,
            event_type: 'page_error',
            description: msg,
            metadata: { source: source + ':' + line, path: location.pathname },
          }),
        }).catch(function(){});
      };
    })();
  </script>
  <script>
    const nav = document.querySelector("nav");
    const motionTargets = document.querySelectorAll(
      "section > *, .service-card, .process-step, .project-card, .content-page > *"
    );

    motionTargets.forEach((target, index) => {
      target.classList.add("reveal");
      target.style.transitionDelay = `${Math.min(index % 6, 5) * 70}ms`;
    });

    const revealObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            revealObserver.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.14, rootMargin: "0px 0px -8% 0px" }
    );

    motionTargets.forEach((target) => revealObserver.observe(target));

    const setNavState = () => {
      nav?.classList.toggle("is-scrolled", window.scrollY > 18);
    };

    window.addEventListener("scroll", setNavState, { passive: true });
    setNavState();

    document.querySelectorAll(".brand-card, .service-card, .project-card").forEach((card) => {
      card.addEventListener("pointermove", (event) => {
        const rect = card.getBoundingClientRect();
        const x = (event.clientX - rect.left) / rect.width - 0.5;
        const y = (event.clientY - rect.top) / rect.height - 0.5;
        card.style.transform = `perspective(900px) rotateX(${y * -5}deg) rotateY(${x * 6}deg) translateY(-4px)`;
      });

      card.addEventListener("pointerleave", () => {
        card.style.transform = "";
      });
    });
  </script>
</body>
</html>
