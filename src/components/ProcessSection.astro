---
import ProcessStep from "./ProcessStep.astro";
---

<section id="process" style="background:var(--navy);text-align:center">
  <span class="section-tag">How we work</span>
  <h2 class="section-title" style="max-width:500px;margin:0 auto 8px;">From brief to delivery — seamlessly</h2>
  <p class="section-sub" style="margin:0 auto;">A clear four-step process that keeps your project on time and on target.</p>
  <div class="process-steps">
    <ProcessStep num="01" title="Discover" description="We listen first — understanding your business, goals, and the specific problems you need solved." />
    <ProcessStep num="02" title="Plan" description="A clear scope, timeline, and budget — agreed before any work begins. No surprises." />
    <ProcessStep num="03" title="Build" description="Our team gets to work — with regular check-ins so you see progress every step of the way." />
    <ProcessStep num="04" title="Launch &amp; Support" description="We deploy, train your team, and stay available — because the relationship doesn't end at handoff." />
  </div>
</section>
