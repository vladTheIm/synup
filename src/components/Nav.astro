---
const { currentPath } = Astro.props;
const links = [
  { href: "/", label: "Home" },
  { href: "/services", label: "Services" },
  { href: "/sms", label: "SchoolPro" },
  { href: "/cms", label: "ChurchCMS" },
  { href: "/projects", label: "Projects" },
  { href: "/about", label: "About" },
  { href: "/contact", label: "Contact" },
];
---

<nav>
  <a href="/" class="nav-logo" style="text-decoration:none;color:var(--white)">Syn<span>Up</span></a>
  <ul class="nav-links">
    {links.map((link) => (
      <li>
        <a href={link.href} set:aria-current={currentPath === link.href ? "page" : undefined}>
          {link.label}
        </a>
      </li>
    ))}
  </ul>
  <a href="/contact" class="nav-cta">Get Started</a>
</nav>
