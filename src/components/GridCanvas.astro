<canvas id="grid-canvas"></canvas>

<script>
(function(){
  const canvas = document.getElementById('grid-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  let W, H, mouse = { x: -9999, y: -9999 };
  const SPACING = 52;
  let pts = [];

  function resize() {
    W = canvas.width = canvas.offsetWidth;
    H = canvas.height = canvas.offsetHeight;
    buildGrid();
  }

  function buildGrid() {
    pts = [];
    const cols = Math.ceil(W / SPACING) + 2;
    const rows = Math.ceil(H / SPACING) + 2;
    for (let r = 0; r < rows; r++) {
      for (let c = 0; c < cols; c++) {
        pts.push({
          bx: (c - 0.5) * SPACING,
          by: (r - 0.5) * SPACING,
          ox: 0, oy: 0
        });
      }
    }
  }

  function draw() {
    ctx.clearRect(0, 0, W, H);
    const t = Date.now() * 0.0008;
    const cols = Math.ceil(W / SPACING) + 2;

    pts.forEach((p) => {
      const dx = p.bx - mouse.x;
      const dy = p.by - mouse.y;
      const dist = Math.sqrt(dx*dx + dy*dy);
      const force = Math.max(0, 1 - dist / 180);
      const tx = -dx * force * 0.35;
      const ty = -dy * force * 0.35;
      p.ox += (tx - p.ox) * 0.12;
      p.oy += (ty - p.oy) * 0.12;
    });

    const COLS = cols;
    const ROWS = (pts.length / COLS) | 0;

    ctx.strokeStyle = 'rgba(0, 150, 220, 0.13)';
    ctx.lineWidth = 0.75;

    for (let r = 0; r < ROWS - 1; r++) {
      for (let c = 0; c < COLS - 1; c++) {
        const idx = r * COLS + c;
        const p = pts[idx];
        const pr = pts[idx + 1];
        const pb = pts[idx + COLS];
        if (!p || !pr || !pb) continue;

        const wave = Math.sin(t + (r + c) * 0.4) * 0.06;
        const alpha = 0.06 + wave + 0.05 * forceVal(p);

        ctx.globalAlpha = Math.max(0.04, Math.min(0.22, alpha));
        ctx.beginPath();
        ctx.moveTo(p.bx + p.ox, p.by + p.oy);
        ctx.lineTo(pr.bx + pr.ox, pr.by + pr.oy);
        ctx.stroke();

        ctx.beginPath();
        ctx.moveTo(p.bx + p.ox, p.by + p.oy);
        ctx.lineTo(pb.bx + pb.ox, pb.by + pb.oy);
        ctx.stroke();

        const nearness = Math.hypot(p.bx - mouse.x, p.by - mouse.y);
        if (nearness < 160) {
          ctx.globalAlpha = (1 - nearness / 160) * 0.7;
          ctx.fillStyle = `rgba(0, 200, 255, 1)`;
          ctx.beginPath();
          ctx.arc(p.bx + p.ox, p.by + p.oy, 1.5, 0, Math.PI*2);
          ctx.fill();
        }
      }
    }

    ctx.globalAlpha = 1;
    requestAnimationFrame(draw);
  }

  function forceVal(p) {
    const d = Math.hypot(p.bx - mouse.x, p.by - mouse.y);
    return Math.max(0, 1 - d / 160);
  }

  window.addEventListener('resize', resize);
  window.addEventListener('mousemove', (e) => {
    const rect = canvas.getBoundingClientRect();
    mouse.x = e.clientX - rect.left;
    mouse.y = e.clientY - rect.top;
  });

  resize();
  draw();
})();
</script>
