---
import GridCanvas from "./GridCanvas.astro";
---

<section class="hero">
  <GridCanvas />
  <p class="hero-eyebrow">SynUp Digital Solutions</p>
  <h1 class="hero-title">
    Your business,<br /><span class="grad">elevated digitally</span>
  </h1>
  <p class="hero-sub">
    We build the systems, websites, networks, and visuals that power modern
    businesses — end to end.
  </p>
  <div class="hero-actions">
    <a href="/services" class="btn-primary">Explore Services</a>
    <a href="/contact" class="btn-ghost">Talk to Us</a>
  </div>
  <div class="hero-stats">
    <div>
      <div class="hero-stat-num">200+</div>
      <div class="hero-stat-label">Projects Delivered</div>
    </div>
    <div>
      <div class="hero-stat-num">98%</div>
      <div class="hero-stat-label">Client Satisfaction</div>
    </div>
    <div>
      <div class="hero-stat-num">5+</div>
      <div class="hero-stat-label">Years Experience</div>
    </div>
  </div>
</section>
