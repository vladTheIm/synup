---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import ServiceCard from "../components/ServiceCard.astro";
import CTASection from "../components/CTASection.astro";

const services = [
  {
    title: "Systems Management",
    description: "We configure, monitor, and maintain your IT systems — servers, hardware, and software — so your operations never skip a beat.",
    icon: `<svg viewBox="0 0 24 24"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/><path d="M9 10l2 2 4-4"/></svg>`,
    details: [
      "Server setup, monitoring, and maintenance",
      "Hardware procurement and lifecycle management",
      "Software installation, updates, and licensing",
      "Backup and disaster recovery planning",
      "Help desk support for your team",
    ],
  },
  {
    title: "Website Development",
    description: "Fast, responsive, and conversion-focused websites built on modern frameworks — designed for the web your customers actually use.",
    icon: `<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>`,
    details: [
      "Custom website design and development",
      "E-commerce and CMS integration",
      "Performance optimization and SEO",
      "Responsive design for all devices",
      "Ongoing maintenance and updates",
    ],
  },
  {
    title: "Networking",
    description: "Reliable, secure network infrastructure — from office LAN setups to enterprise-grade wireless systems and VPN configurations.",
    icon: `<svg viewBox="0 0 24 24"><rect x="2" y="14" width="6" height="4" rx="1"/><rect x="9" y="8" width="6" height="10" rx="1"/><rect x="16" y="4" width="6" height="14" rx="1"/><path d="M5 14V9M12 8V5M19 4V2"/></svg>`,
    details: [
      "LAN/WAN design and deployment",
      "Wireless infrastructure and access points",
      "VPN configuration for remote work",
      "Network security and firewall setup",
      "Ongoing network monitoring and support",
    ],
  },
  {
    title: "Graphics Designing",
    description: "Brand identity, marketing materials, and UI assets crafted with precision — visuals that communicate authority and build recognition.",
    icon: `<svg viewBox="0 0 24 24"><path d="M12 19l7-7 3 3-7 7-3-3z"/><path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"/><path d="M2 2l7.586 7.586"/><circle cx="11" cy="11" r="2"/></svg>`,
    details: [
      "Brand identity and logo design",
      "Marketing collateral (flyers, brochures, banners)",
      "UI/UX design for web and mobile",
      "Social media graphics and templates",
      "Presentation decks and pitch materials",
    ],
  },
];
---

<BaseLayout title="Services" description="Explore SynUp Digital Solutions' four core services: Systems Management, Website Development, Networking, and Graphics Design.">
  <Nav currentPath="/services" />
  <main>
    <div class="page-header">
      <span class="section-tag">What we do</span>
      <h1 class="section-title">Our Services</h1>
      <p class="section-sub">End-to-end digital solutions for your business. No outsourcing, no gaps — just one reliable team.</p>
    </div>

    <section style="padding-top:0">
      {services.map((s) => (
        <div style="margin-bottom:64px">
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:center" class="service-detail">
            <div>
              <div class="service-icon" set:html={s.icon}></div>
              <h2 class="section-title" style="margin-top:16px">{s.title}</h2>
              <p class="section-sub" style="max-width:100%">{s.description}</p>
              <ul class="about-list">
                {s.details.map((d) => (
                  <li>
                    <div class="check-icon"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></div>
                    {d}
                  </li>
                ))}
              </ul>
            </div>
            <div class="service-card" style="margin:0">
              <div class="service-icon" set:html={s.icon}></div>
              <h3>{s.title}</h3>
              <p>{s.description}</p>
            </div>
          </div>
        </div>
      ))}
    </section>

    <CTASection />
  </main>
  <Footer />
</BaseLayout>

<style>
  .service-detail { grid-template-columns: 1fr 1fr; }
  @media (max-width: 768px) {
    .service-detail { grid-template-columns: 1fr; }
    .service-detail .service-card { display: none; }
  }
</style>
