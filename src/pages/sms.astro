---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import CTASection from "../components/CTASection.astro";
---

<BaseLayout title="SchoolPro - School Management System" description="SchoolPro is a full-featured school management platform by SynUp Digital Solutions. Student records, attendance, transcripts, scheduling, exams, and more.">
  <Nav currentPath="/sms" />
  <main>
    <div class="page-header" style="padding-bottom:40px">
      <span class="section-tag">Product</span>
      <h1 class="section-title">SchoolPro</h1>
      <p class="section-sub" style="max-width:600px">A complete school management system — from student enrollment to report cards, all in one platform.</p>
      <div style="margin-top:24px;display:flex;gap:14px;justify-content:center;flex-wrap:wrap">
        <a href="https://sms-web-1.onrender.com" class="btn-primary" target="_blank">Open SchoolPro &rarr;</a>
      </div>
    </div>

    <section style="padding-top:0;background:var(--navy2)">
      <div style="max-width:900px;margin:0 auto">
        <span class="section-tag">Overview</span>
        <h2 class="section-title">Purpose-built for schools</h2>
        <p class="section-sub" style="max-width:100%;margin-bottom:32px">
          SchoolPro replaces scattered spreadsheets, paper records, and disconnected tools with a unified platform
          serving 50+ staff across 4 schools. Every aspect of school operations — from admissions to alumni — is
          managed through a single dashboard.
        </p>

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:48px">
          <div class="service-card" style="margin:0">
            <h3 style="margin-bottom:8px">Student Records</h3>
            <p>Centralized profiles with enrollment history, medical info, guardian contacts, and document storage.</p>
          </div>
          <div class="service-card" style="margin:0">
            <h3 style="margin-bottom:8px">Attendance &amp; Timetables</h3>
            <p>Daily attendance tracking, period-by-period registers, automated SMS alerts for absentees, and timetable management.</p>
          </div>
          <div class="service-card" style="margin:0">
            <h3 style="margin-bottom:8px">Exams &amp; Grades</h3>
            <p>Exam scheduling, grade entry, automated report cards, transcripts, and performance analytics by class and subject.</p>
          </div>
          <div class="service-card" style="margin:0">
            <h3 style="margin-bottom:8px">Finance &amp; Fees</h3>
            <p>Fee structure setup, payment tracking, receipts, outstanding balances, and financial reporting per term.</p>
          </div>
          <div class="service-card" style="margin:0">
            <h3 style="margin-bottom:8px">Communication</h3>
            <p>Bulk SMS and email to parents, push notifications for events and emergencies, and in-app messaging between staff.</p>
          </div>
          <div class="service-card" style="margin:0">
            <h3 style="margin-bottom:8px">Staff &amp; HR</h3>
            <p>Staff profiles, attendance, payroll integration, leave management, and performance evaluation records.</p>
          </div>
        </div>
      </div>
    </section>

    <section style="background:var(--navy);text-align:center">
      <span class="section-tag">Tech Stack</span>
      <h2 class="section-title" style="max-width:500px;margin:0 auto 24px">Built for scale and reliability</h2>
      <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;max-width:600px;margin:0 auto">
        <span class="project-tag" style="font-size:13px;padding:6px 18px">Node.js</span>
        <span class="project-tag" style="font-size:13px;padding:6px 18px">React</span>
        <span class="project-tag" style="font-size:13px;padding:6px 18px">PostgreSQL</span>
        <span class="project-tag" style="font-size:13px;padding:6px 18px">REST API</span>
        <span class="project-tag" style="font-size:13px;padding:6px 18px">Render Hosting</span>
        <span class="project-tag" style="font-size:13px;padding:6px 18px">SMS Gateway</span>
      </div>
    </section>

    <section class="cta-section" style="background:var(--navy2)">
      <span class="section-tag">Get Started</span>
      <h2 class="cta-title">Interested in SchoolPro for your school?</h2>
      <p class="cta-sub">We'll set up a demo and walk you through everything.</p>
      <div class="cta-actions">
        <a href="https://sms-web-1.onrender.com" class="btn-primary" target="_blank">Try SchoolPro &rarr;</a>
        <a href="/contact" class="btn-ghost">Talk to Us</a>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
